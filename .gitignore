# Secrets & Credentials
.env
data/config.yaml
data/.soundcloud_auth/
data/auth.lock

# Runtime state — exclude (generated music, logs, sessions, caches)
data/logs/
data/sessions/
data/home/
data/dawagent/
data/music/productions/
data/music/albums/
data/music/releases/
data/music/exports/
data/music/proposals/
data/music/profiles/*/batches/
data/productions/
data/snapshots/
data/cache/
data/.cache/
data/.config/
data/.local/
data/bin/
data/audio_cache/
data/tmp/
data/gateway*
data/channel_directory.json
data/processes.json
data/memories/
data/cron/
data/*cache*.json
data/*.lock
data/*.tmp
data/*.zip
**/cloudflared
**/cloudflared.exe

# Python bytecode
**/__pycache__/
*.pyc
*.pyo

# SQLite databases (runtime)
*.db
*.db-shm
*.db-wal

# Logs
*.log

# OS artifacts
.DS_Store
Thumbs.db

# Source — explicitly tracked (override runtime exclusions above)
!data/scripts/
!data/skills/
!data/music/profiles/
!data/soul/
