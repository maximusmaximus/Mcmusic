# Secrets & Credentials
.env*
!.env.example
*.key
*.pem
*.cert
*.crt
*token*.json
*credential*.json
*credentials/
id_rsa*
id_ed25519*
config.yaml
**/config.yaml
data/config.yaml
data/.soundcloud_auth/
data/auth.lock

# Runtime state — exclude (generated music, logs, sessions, caches)
data/logs/
data/sessions/
data/home/
data/dawagent/
data/music/productions/
data/music/albums/
data/music/releases/
data/music/exports/
data/music/proposals/
data/music/profiles/*/batches/
data/productions/
data/snapshots/
data/cache/
data/.cache/
data/.config/
data/.local/
data/bin/
data/audio_cache/
data/tmp/
data/gateway*
data/channel_directory.json
data/processes.json
data/memories/
data/cron/
data/*cache*.json
data/*.lock
data/*.tmp
data/*.zip
data/.*
data/music/artwork/
data/skills/.*
data/test_*.png
**/cloudflared
**/cloudflared.exe

# Python bytecode
**/__pycache__/
*.pyc
*.pyo

# SQLite databases (runtime)
*.db
*.db-shm
*.db-wal

# Logs
*.log

# OS artifacts
.DS_Store
Thumbs.db

# Source — explicitly tracked (override runtime exclusions above)
!data/scripts/
!data/skills/
!data/music/profiles/
!data/soul/

# Re-apply critical exclusions inside tracked source directories
data/**/__pycache__/
data/**/*.pyc
data/**/*.pyo
data/**/.env*
data/**/config.yaml
data/**/*tokens.json
data/**/*credentials.json
data/**/*.key
data/**/*.pem
skills/**/__pycache__/
skills/**/*.pyc
skills/**/*.pyo

