# Secrets
.env

# Runtime state — exclude (generated music, logs, sessions, caches)
data/logs/
data/sessions/
data/home/
data/dawagent/
data/music/productions/
data/music/albums/
data/music/releases/
data/music/exports/
data/music/proposals/
data/music/profiles/*/batches/

# Python bytecode
**/__pycache__/
*.pyc
*.pyo

# SQLite databases (runtime)
*.db
*.db-shm
*.db-wal

# Logs
*.log

# OS artifacts
.DS_Store
Thumbs.db

# Source — explicitly tracked (override runtime exclusions above)
!data/scripts/
!data/skills/
!data/music/profiles/
!data/soul/
